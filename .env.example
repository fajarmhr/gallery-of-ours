# ── Required ────────────────────────────────────────────────
# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/gallery?sslmode=verify-full
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────
# Anyone signing up with this email becomes superadmin and is approved automatically
SUPERADMIN_EMAIL=
APP_TIMEZONE=Asia/Jakarta
# Extra origins allowed to sign in, e.g. http://192.168.1.10:3000 for testing on a phone
TRUSTED_ORIGINS=

# Photos and videos. Leave R2 empty to store files in LOCAL_STORAGE_DIR (development only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOCAL_STORAGE_DIR=.data/uploads

# Emails. Leave empty to print verification and reset emails in the terminal
RESEND_API_KEY=
EMAIL_FROM="Gallery of Ours <family@your-domain.com>"

# Existing Cloudinary accounts admins can import from. Copy "API environment variable" from Settings → API Keys.
# Imported photos stay in Cloudinary but become private (authenticated); emptying the trash deletes them there too.
CLOUDINARY_URL_1=
CLOUDINARY_URL_2=

# AI captions and search tags. Leave empty to turn AI off
ANTHROPIC_API_KEY=
AI_DAILY_CAPTION_LIMIT=300
