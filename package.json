{
  "name": "gallery-of-ours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --webpack",
    "build": "node scripts/copy-maplibre-worker.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:push:prod": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:remove": "tsx --env-file=.env.local scripts/remove-demo.ts",
    "seed:remove:prod": "tsx --env-file=.env.production.local scripts/remove-demo.ts",
    "create-superadmin": "tsx --env-file=.env.local scripts/create-superadmin.ts",
    "create-superadmin:prod": "tsx --env-file=.env.production.local scripts/create-superadmin.ts",
    "storage:organize": "tsx --env-file=.env.local scripts/organize-storage.ts",
    "storage:organize:prod": "tsx --env-file=.env.production.local scripts/organize-storage.ts",
    "test:upload": "tsx --test scripts/upload-regression.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "cloudinary": "2.11.0",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "heic-to": "^1.6.7",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.3",
    "react-photo-album": "^3.6.2",
    "resend": "^6.39.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
